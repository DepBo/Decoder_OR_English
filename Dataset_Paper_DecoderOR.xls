<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
         <head><meta charset="UTF-8"><style>table { border-collapse:collapse; } th, td { border:1px solid #000; padding: 4px; font-family: Arial, sans-serif; font-size: 12px; }</style></head>
         <body><table border="1" style="border-collapse:collapse; width:100%; font-family: Arial, sans-serif; font-size: 12px;">
                          <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                          <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">_metadata</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">title</td><td align="left" valign="middle" style="border:1px solid #000;">Benchmark Dataset for Decoder-OR Logic Design Verification</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">description</td><td align="left" valign="middle" style="border:1px solid #000;">Five standard combinational benchmark circuits represented as Sum-of-Minterms for each output. Suitable for automated testing of Decoder-OR synthesis algorithms.</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">version</td><td align="left" valign="middle" style="border:1px solid #000;">1.0</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">bit_ordering</td><td align="left" valign="middle" style="border:1px solid #000;">MSB-first (leftmost input = most significant bit)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">minterm_index</td><td align="left" valign="middle" style="border:1px solid #000;">Decimal index of the canonical minterm, where the first input variable maps to the MSB of the index.</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">notes</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">dont_cares</td><td align="left" valign="middle" style="border:1px solid #000;">Entries in 'dont_cares_map' are minterms where the output is undefined (X). For synthesis, these may be used to minimize the circuit.</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">BCD_to_7Segment</td><td align="left" valign="middle" style="border:1px solid #000;">Common-cathode display convention (segment active HIGH). Inputs A,B,C,D represent BCD digits 0–9. States 10–15 are don't-cares.</td></tr></tbody>
              </table></td></tr></tbody>
              </table></td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">benchmarks</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">id</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">name</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">description</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">num_inputs</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">inputs</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">input_bit_width</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">num_outputs</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">outputs</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">minterms_map</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">dont_cares_map</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">canonical_expressions</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">segment_layout_comment</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">segment_layout_comment_2</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">segment_layout_comment_3</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">minterm_index_formula</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">total_minterms</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">verification</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">1</td><td align="left" valign="middle" style="border:1px solid #000;">Half_Adder</td><td align="left" valign="middle" style="border:1px solid #000;">1-bit half adder: adds two single bits A and B.</td><td align="left" valign="middle" style="border:1px solid #000;">2</td><td align="left" valign="middle" style="border:1px solid #000;">A, B</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;">2</td><td align="left" valign="middle" style="border:1px solid #000;">Sum, Cout</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">Sum</td><td align="left" valign="middle" style="border:1px solid #000;">1, 2</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">Cout</td><td align="left" valign="middle" style="border:1px solid #000;">3</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">Sum</td><td align="left" valign="middle" style="border:1px solid #000;">A'B + AB' = A XOR B</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">Cout</td><td align="left" valign="middle" style="border:1px solid #000;">AB</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">2</td><td align="left" valign="middle" style="border:1px solid #000;">Full_Adder</td><td align="left" valign="middle" style="border:1px solid #000;">1-bit full adder: adds three bits A, B, and carry-in Cin.</td><td align="left" valign="middle" style="border:1px solid #000;">3</td><td align="left" valign="middle" style="border:1px solid #000;">A, B, Cin</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">Cin</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;">2</td><td align="left" valign="middle" style="border:1px solid #000;">Sum, Cout</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">Sum</td><td align="left" valign="middle" style="border:1px solid #000;">1, 2, 4, 7</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">Cout</td><td align="left" valign="middle" style="border:1px solid #000;">3, 5, 6, 7</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">Sum</td><td align="left" valign="middle" style="border:1px solid #000;">A'B'Cin + A'BCin' + AB'Cin' + ABCin = A XOR B XOR Cin</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">Cout</td><td align="left" valign="middle" style="border:1px solid #000;">A'BCin + AB'Cin + ABCin' + ABCin = AB + ACin + BCin</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">3</td><td align="left" valign="middle" style="border:1px solid #000;">2_to_1_MUX</td><td align="left" valign="middle" style="border:1px solid #000;">2-to-1 Multiplexer: select line S routes I0 (when S=0) or I1 (when S=1) to output Y.</td><td align="left" valign="middle" style="border:1px solid #000;">3</td><td align="left" valign="middle" style="border:1px solid #000;">S, I0, I1</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">S</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">I0</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">I1</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;">1</td><td align="left" valign="middle" style="border:1px solid #000;">Y</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
