                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">C</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">D</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;">7</td><td align="left" valign="middle" style="border:1px solid #000;">a, b, c, d, e, f, g</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">a</td><td align="left" valign="middle" style="border:1px solid #000;">0, 2, 3, 5, 6, 7, 8, 9</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">b</td><td align="left" valign="middle" style="border:1px solid #000;">0, 1, 2, 3, 4, 7, 8, 9</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">c</td><td align="left" valign="middle" style="border:1px solid #000;">0, 1, 3, 4, 5, 6, 7, 8, 9</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">d</td><td align="left" valign="middle" style="border:1px solid #000;">0, 2, 3, 5, 6, 8, 9</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">e</td><td align="left" valign="middle" style="border:1px solid #000;">0, 2, 6, 8</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">f</td><td align="left" valign="middle" style="border:1px solid #000;">0, 4, 5, 6, 8, 9</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">g</td><td align="left" valign="middle" style="border:1px solid #000;">2, 3, 4, 5, 6, 8, 9</td></tr></tbody>
