              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">a</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,2,3,5,6,7,8,9) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">b</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,1,2,3,4,7,8,9) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">c</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,1,3,4,5,6,7,8,9) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">d</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,2,3,5,6,8,9) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">e</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,2,6,8) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">f</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,4,5,6,8,9) + d(10-15)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">g</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(2,3,4,5,6,8,9) + d(10-15)</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"> _      <- a</td><td align="left" valign="middle" style="border:1px solid #000;">|_|  <- f, g, b</td><td align="left" valign="middle" style="border:1px solid #000;">|_|  <- e, d, c</td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">5</td><td align="left" valign="middle" style="border:1px solid #000;">3bit_Comparator</td><td align="left" valign="middle" style="border:1px solid #000;">3-bit magnitude comparator. Inputs A2,A1,A0 (MSB-first) form value A; B2,B1,B0 form value B. Outputs indicate A>B, A=B, A<B.</td><td align="left" valign="middle" style="border:1px solid #000;">6</td><td align="left" valign="middle" style="border:1px solid #000;">A2, A1, A0, B2, B1, B0</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A2</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A1</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A0</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B2</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B1</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">B0</td><td align="left" valign="middle" style="border:1px solid #000;">1</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;">3</td><td align="left" valign="middle" style="border:1px solid #000;">A_gt_B, A_eq_B, A_lt_B</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A_gt_B</td><td align="left" valign="middle" style="border:1px solid #000;">8, 16, 17, 24, 25, 26, 32, 33, 34, 35, 40, 41, 42, 43, 44, 48, 49, 50, 51, 52, 53, 56, 57, 58, 59, 60, 61, 62</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_eq_B</td><td align="left" valign="middle" style="border:1px solid #000;">0, 9, 18, 27, 36, 45, 54, 63</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_lt_B</td><td align="left" valign="middle" style="border:1px solid #000;">1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 19, 20, 21, 22, 23, 28, 29, 30, 31, 37, 38, 39, 46, 47, 55</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A_gt_B</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(8,16,17,24,25,26,32,33,34,35,40,41,42,43,44,48,49,50,51,52,53,56,57,58,59,60,61,62)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_eq_B</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(0,9,18,27,36,45,54,63)</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_lt_B</td><td align="left" valign="middle" style="border:1px solid #000;">Sigma_m(1,2,3,4,5,6,7,10,11,12,13,14,15,19,20,21,22,23,28,29,30,31,37,38,39,46,47,55)</td></tr></tbody>
              </table></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;"></td><td align="left" valign="middle" style="border:1px solid #000;">index = A2*32 + A1*16 + A0*8 + B2*4 + B1*2 + B0</td><td align="left" valign="middle" style="border:1px solid #000;">64</td><td align="left" valign="middle" style="border:1px solid #000;"><table border="1" style="border-collapse:collapse; width:100%;">
                <thead><tr><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">key</th><th align="left" valign="middle" style="border:1px solid #000; background-color:#f0f0f0; font-weight:bold;">value</th></tr></thead>
                <tbody><tr><td align="left" valign="middle" style="border:1px solid #000;">A_gt_B_count</td><td align="left" valign="middle" style="border:1px solid #000;">28</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_eq_B_count</td><td align="left" valign="middle" style="border:1px solid #000;">8</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">A_lt_B_count</td><td align="left" valign="middle" style="border:1px solid #000;">28</td></tr><tr><td align="left" valign="middle" style="border:1px solid #000;">total_check</td><td align="left" valign="middle" style="border:1px solid #000;">28 + 8 + 28 = 64 = 2^6 (all minterms covered, no overlap)</td></tr></tbody>
              </table></td></tr></tbody>
              </table></td></tr></tbody>
