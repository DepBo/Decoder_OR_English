{
  "_metadata": {
    "title": "Benchmark Dataset for Decoder-OR Logic Design Verification",
    "description": "Five standard combinational benchmark circuits represented as Sum-of-Minterms for each output. Suitable for automated testing of Decoder-OR synthesis algorithms.",
    "version": "1.0",
    "bit_ordering": "MSB-first (leftmost input = most significant bit)",
    "minterm_index": "Decimal index of the canonical minterm, where the first input variable maps to the MSB of the index.",
    "notes": {
      "dont_cares": "Entries in 'dont_cares_map' are minterms where the output is undefined (X). For synthesis, these may be used to minimize the circuit.",
      "BCD_to_7Segment": "Common-cathode display convention (segment active HIGH). Inputs A,B,C,D represent BCD digits 0–9. States 10–15 are don't-cares."
    }
  },
  "benchmarks": [
    {
      "id": 1,
      "name": "Half_Adder",
      "description": "1-bit half adder: adds two single bits A and B.",
      "num_inputs": 2,
      "inputs": ["A", "B"],
      "input_bit_width": { "A": 1, "B": 1 },
      "num_outputs": 2,
      "outputs": ["Sum", "Cout"],
      "minterms_map": {
        "Sum":  [1, 2],
        "Cout": [3]
      },
      "dont_cares_map": {},
      "canonical_expressions": {
        "Sum":  "A'B + AB' = A XOR B",
        "Cout": "AB"
      }
    },
    {
      "id": 2,
      "name": "Full_Adder",
      "description": "1-bit full adder: adds three bits A, B, and carry-in Cin.",
      "num_inputs": 3,
      "inputs": ["A", "B", "Cin"],
      "input_bit_width": { "A": 1, "B": 1, "Cin": 1 },
      "num_outputs": 2,
      "outputs": ["Sum", "Cout"],
      "minterms_map": {
        "Sum":  [1, 2, 4, 7],
        "Cout": [3, 5, 6, 7]
      },
      "dont_cares_map": {},
      "canonical_expressions": {
        "Sum":  "A'B'Cin + A'BCin' + AB'Cin' + ABCin = A XOR B XOR Cin",
        "Cout": "A'BCin + AB'Cin + ABCin' + ABCin = AB + ACin + BCin"
      }
    },
    {
      "id": 3,
      "name": "2_to_1_MUX",
      "description": "2-to-1 Multiplexer: select line S routes I0 (when S=0) or I1 (when S=1) to output Y.",
      "num_inputs": 3,
      "inputs": ["S", "I0", "I1"],
      "input_bit_width": { "S": 1, "I0": 1, "I1": 1 },
      "num_outputs": 1,
      "outputs": ["Y"],
      "minterms_map": {
        "Y": [2, 3, 5, 7]
      },
      "dont_cares_map": {},
      "canonical_expressions": {
        "Y": "S'I0 + SI1"
      }
    },
    {
      "id": 4,
      "name": "BCD_to_7Segment",
      "description": "BCD to 7-segment decoder (common-cathode, active HIGH). Inputs A(MSB),B,C,D(LSB) encode digits 0–9. Segments a–g drive the display.",
      "num_inputs": 4,
      "inputs": ["A", "B", "C", "D"],
      "input_bit_width": { "A": 1, "B": 1, "C": 1, "D": 1 },
      "num_outputs": 7,
      "outputs": ["a", "b", "c", "d", "e", "f", "g"],
      "segment_layout_comment": " _      <- a",
      "segment_layout_comment_2": "|_|  <- f, g, b",
      "segment_layout_comment_3": "|_|  <- e, d, c",
      "minterms_map": {
        "a": [0, 2, 3, 5, 6, 7, 8, 9],
        "b": [0, 1, 2, 3, 4, 7, 8, 9],
        "c": [0, 1, 3, 4, 5, 6, 7, 8, 9],
        "d": [0, 2, 3, 5, 6, 8, 9],
        "e": [0, 2, 6, 8],
        "f": [0, 4, 5, 6, 8, 9],
        "g": [2, 3, 4, 5, 6, 8, 9]
      },
      "dont_cares_map": {
        "a": [10, 11, 12, 13, 14, 15],
        "b": [10, 11, 12, 13, 14, 15],
        "c": [10, 11, 12, 13, 14, 15],
        "d": [10, 11, 12, 13, 14, 15],
        "e": [10, 11, 12, 13, 14, 15],
        "f": [10, 11, 12, 13, 14, 15],
        "g": [10, 11, 12, 13, 14, 15]
      },
      "canonical_expressions": {
        "a": "Sigma_m(0,2,3,5,6,7,8,9) + d(10-15)",
        "b": "Sigma_m(0,1,2,3,4,7,8,9) + d(10-15)",
        "c": "Sigma_m(0,1,3,4,5,6,7,8,9) + d(10-15)",
        "d": "Sigma_m(0,2,3,5,6,8,9) + d(10-15)",
        "e": "Sigma_m(0,2,6,8) + d(10-15)",
        "f": "Sigma_m(0,4,5,6,8,9) + d(10-15)",
        "g": "Sigma_m(2,3,4,5,6,8,9) + d(10-15)"
      }
    },
    {
      "id": 5,
      "name": "3bit_Comparator",
      "description": "3-bit magnitude comparator. Inputs A2,A1,A0 (MSB-first) form value A; B2,B1,B0 form value B. Outputs indicate A>B, A=B, A<B.",
      "num_inputs": 6,
      "inputs": ["A2", "A1", "A0", "B2", "B1", "B0"],
      "input_bit_width": { "A2": 1, "A1": 1, "A0": 1, "B2": 1, "B1": 1, "B0": 1 },
      "num_outputs": 3,
      "outputs": ["A_gt_B", "A_eq_B", "A_lt_B"],
      "minterm_index_formula": "index = A2*32 + A1*16 + A0*8 + B2*4 + B1*2 + B0",
      "total_minterms": 64,
      "minterms_map": {
        "A_gt_B": [
          8,
          16, 17,
          24, 25, 26,
          32, 33, 34, 35,
          40, 41, 42, 43, 44,
          48, 49, 50, 51, 52, 53,
          56, 57, 58, 59, 60, 61, 62
        ],
        "A_eq_B": [
          0, 9, 18, 27, 36, 45, 54, 63
        ],
        "A_lt_B": [
          1, 2, 3, 4, 5, 6, 7,
          10, 11, 12, 13, 14, 15,
          19, 20, 21, 22, 23,
          28, 29, 30, 31,
          37, 38, 39,
          46, 47,
          55
        ]
      },
      "dont_cares_map": {},
      "verification": {
        "A_gt_B_count": 28,
        "A_eq_B_count": 8,
        "A_lt_B_count": 28,
        "total_check": "28 + 8 + 28 = 64 = 2^6 (all minterms covered, no overlap)"
      },
      "canonical_expressions": {
        "A_gt_B": "Sigma_m(8,16,17,24,25,26,32,33,34,35,40,41,42,43,44,48,49,50,51,52,53,56,57,58,59,60,61,62)",
        "A_eq_B": "Sigma_m(0,9,18,27,36,45,54,63)",
        "A_lt_B": "Sigma_m(1,2,3,4,5,6,7,10,11,12,13,14,15,19,20,21,22,23,28,29,30,31,37,38,39,46,47,55)"
      }
    }
  ]
}
